# Copy to .env (mode 0600). Production requires HTTPS + wildcard DNS/TLS.
PLATFORM_ORIGIN=https://research.example.org
# Browser-visible OpenResearch homepage after unified login.
OPENRESEARCH_APP_ORIGIN=https://app.example.org
# Generate independently, e.g. openssl rand -hex 24. No default password.
PLATFORM_DB_PASSWORD=
# Only used by host-side Node development/admin commands; container Compose uses db:5432.
DATABASE_URL=
# DeepLiterature is the only supported SSO client. Use its public HTTPS origin.
DEEPLIT_ORIGIN=https://literature.example.org
# Generate independently and configure the same 32+ character value in DeepLiterature.
DEEPLIT_SSO_CLIENT_SECRET=

# Password recovery mail. Empty SMTP_HOST disables mail recovery explicitly.
# Use port 465 (TLS) or 587 (required STARTTLS). Never commit SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
