ARG UV_VERSION=0.13.5
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# Exportable dependency bundle: update packages install it without server networking.
FROM node:22-bookworm-slim AS executor-packages
RUN rm -f /etc/apt/apt.conf.d/docker-clean && apt-get update && \
    apt-get -o Dir::State::status=/dev/null install -y --download-only --no-install-recommends \
      git openssh-client ca-certificates curl wget bash \
      python3 python-is-python3 python3-pip python3-venv python3-dev \
      build-essential pkg-config ripgrep jq sqlite3 zip unzip file procps time poppler-utils \
      python3-numpy python3-pandas python3-scipy python3-matplotlib python3-openpyxl \
      python3-requests python3-bs4 python3-lxml python3-pil python3-docx \
      python3-pyshp python3-shapely python3-pypdf2 && \
    mkdir -p /opt/executor-tools/debs && cp /var/cache/apt/archives/*.deb /opt/executor-tools/debs/
COPY --from=uv /uv /uvx /opt/executor-tools/bin/
COPY packages/platform/executor-tools/ /opt/executor-tools/

FROM node:22-bookworm-slim AS executor-runtime
RUN --network=none --mount=from=executor-packages,source=/opt/executor-tools,target=/tmp/executor-tools,rw \
    sh /tmp/executor-tools/install.sh
ENV PATH="/home/node/.local/bin:${PATH}"
USER node
RUN orx-check-executor-tools

FROM rust:1.93-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY linux ./linux
COPY ui/dist ./ui/dist
COPY ui/src/researchWorkflows.json ./ui/src/researchWorkflows.json
COPY agent-skills ./agent-skills
COPY demo ./demo
COPY SYSTEM_PROMPT.md SKILL.md ./
RUN cargo build --release --locked

FROM executor-runtime
USER root
ARG OPENCODE_VERSION=1.18.33
RUN npm install --global opencode-ai@${OPENCODE_VERSION} && opencode --version
WORKDIR /app/platform
COPY packages/platform/package.json packages/platform/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY packages/platform/src ./src
COPY --from=build /src/target/release/orx /usr/local/bin/orx
COPY LICENSE /usr/share/doc/openresearch/LICENSE
RUN mkdir -p /home/node/research /home/node/.runner-state /home/node/.config/opencode /home/node/.local/share /home/node/.local/state /home/node/.cache && chown -R node:node /home/node
RUN orx-prepare-executor
USER node
RUN orx-check-executor-tools
ENV ORX_DATA_DIR=/home/node/research/state RUNNER_STATE_DIR=/home/node/.runner-state RUNNER_ISOLATION_ACK=dedicated-workspace ORX_UPSTREAM=http://127.0.0.1:4791
ENV HOME=/home/node XDG_CONFIG_HOME=/home/node/.config XDG_DATA_HOME=/home/node/.local/share XDG_STATE_HOME=/home/node/.local/state XDG_CACHE_HOME=/home/node/.cache OPENCODE_DISABLE_AUTOUPDATE=1
CMD ["node", "src/executor-entry.mjs"]
